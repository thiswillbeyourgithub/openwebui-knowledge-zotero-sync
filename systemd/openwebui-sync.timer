[Unit]
# Timer to run OpenWebUI sync daily
Description=Daily OpenWebUI Knowledge Sync
Requires=openwebui-sync.service

[Timer]
# Run daily at 2:00 AM
# TODO: Adjust the time as needed
# Format: OnCalendar=DayOfWeek Year-Month-Day Hour:Minute:Second
# Examples:
#   OnCalendar=*-*-* 02:00:00        # Every day at 2:00 AM
#   OnCalendar=Mon *-*-* 02:00:00    # Every Monday at 2:00 AM
#   OnCalendar=*-*-01 02:00:00       # First day of each month at 2:00 AM
OnCalendar=*-*-* 02:00:00

# Wait 5 minutes if the system was off at the scheduled time
Persistent=true

# Add random delay up to 10 minutes to avoid load spikes if multiple systems sync
# TODO: Remove or adjust RandomizedDelaySec as needed
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
